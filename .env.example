# ---------------------------------------------------------------------------
# Kargo Hiring Command Centre — environment variables
# Copy to .env.local for local dev (git-ignored) and add the same keys in
# Vercel → Project → Settings → Environment Variables. Never commit real values.
# All of these are read on the SERVER only; none is exposed to the browser.
# ---------------------------------------------------------------------------

# Supabase project URL — Dashboard → Project Settings → Data API
# (project: kargo-hiring-command-centre, ref cuhqannplwlslcktzpno)
SUPABASE_URL=https://cuhqannplwlslcktzpno.supabase.co

# Supabase anon / publishable key — Dashboard → Project Settings → API Keys
# https://supabase.com/dashboard/project/cuhqannplwlslcktzpno/settings/api-keys
# Public by design; every table is protected by row-level security (founder allowlist).
SUPABASE_ANON_KEY=

# Gemini API key — https://aistudio.google.com/apikey
# Free-tier keys: Google may use inputs to improve its products. Use a billed key for real candidate data.
GEMINI_API_KEY=

# Gemini model id (configurable). Default: gemini-3.8-flash (stable Flash model, Oct 2026).
GEMINI_MODEL=gemini-3.8-flash

# Resend — LEAVE BLANK for checkpoint L4·2. While blank the app shows
# "Email sending is not configured" and never pretends to send.
RESEND_API_KEY=

# Sender address (the domain must be verified in Resend)
RESEND_FROM_EMAIL=squad_8@pg27.mesaschool.co

# Test mode (default ON). Anything other than "false" keeps it on.
# In test mode every email goes to MESA_TEST_EMAIL; candidates are never contacted.
EMAIL_TEST_MODE=true

# Required before ANY test send is allowed
MESA_TEST_EMAIL=karan_kulkarni@pg27.mesaschool.co

# --- Extra variables (genuinely needed or useful) ---------------------------

# Second, explicit switch for real-candidate sending. Live sends require BOTH
# EMAIL_TEST_MODE=false AND ALLOW_LIVE_CANDIDATE_EMAILS=true. Default: locked.
ALLOW_LIVE_CANDIDATE_EMAILS=false

# Signature substituted for {{sender_name}} in drafts
EMAIL_SENDER_NAME=Arjun Mehta, Founder, Kargo

# Gemini thinking level: low (default, fastest) | medium | high | off
GEMINI_THINKING_LEVEL=low

# OPTIONAL — only for the daily Vercel Cron fallback worker (drains the queue when no
# browser tab is open). Service-role key bypasses RLS: server-only, never NEXT_PUBLIC_.
# Dashboard → Project Settings → API Keys → service_role / secret key.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
